{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "asaas": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-stdio-proxy",
                "https://docs.asaas.com/mcp"
            ]
        }
        //other mcp servers
    }
}
