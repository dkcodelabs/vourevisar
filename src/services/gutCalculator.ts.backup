import { GoogleGenerativeAI } from '@google/generative-ai'
import { createClient } from '@supabase/supabase-js'
import md5 from 'crypto-js/md5'

/**
 * Serviço para calcular a Tendência (GUT) baseada no volume de questões encontrados no Google.
 * Implementa Smart GUT v16: Validação IA + Cache Global + Histórico para BI.
 */

// ============================================
// INTERFACES v16
// ============================================

interface AIAnalysisResult {
    isValid: boolean        // false se for lixo/teste
    reasoning: string       // Ex: "Aprovado: Separei 'Hardware e Redes'"
    tags: string[]          // Termos normalizados para busca
}

interface TermBreakdown {
    term: string
    volume: number
    source: 'CACHE' | 'API'
    data_source: string     // v16.5: "Google Custom Search" | "Cache (Interno)"
}

interface GutResultV16 {
    success: boolean
    reasoning: string                    // Reasoning da IA
    topicosSeparados: string[]           // Tags normalizadas
    termoMaiorRisco: string              // Termo com maior volume
    volumeMaximo: number                 // Volume do termo campeão
    notaGut: 1 | 2 | 3 | 4 | 5
    breakdown: TermBreakdown[]           // Detalhamento de cada termo
    api_stats: {
        cache_hits: number               // Quantos termos vieram do cache
        api_calls: number                // Quantos termos buscaram Google
        usadas_sessao: number            // Total de chamadas Google nesta sessão
        restantes: number
        cota_maxima: number
    }
    error?: string                       // Mensagem de erro (se success === false)
}

// v16.5: Interface estendida com agregação de volume
interface GutResultV16_5 extends GutResultV16 {
    total_topic_volume: number           // Soma de todos os sub-volumes
    aggregation_count: number            // Quantos sub-termos foram somados
    data_sources: {
        cache_count: number              // Quantos termos vieram do cache
        api_count: number                // Quantos termos buscaram Google
        primary_source: string           // "Cache" | "Google Custom Search"
    }
}

// Interface para logs de automação
interface ProcessedTopic {
    id: string
    timestamp: Date
    topico_original: string
    materia: string
    total_volume: number
    maior_sub_topico: string
    status: 'success' | 'rejected' | 'error'
    reasoning?: string
}

const COTA_DIARIA_MAXIMA = 100
const STORAGE_KEY_COTA = 'gut_api_quota'
const CACHE_TTL_DAYS = 30

// --- SUPABASE CLIENT ---
const getSupabaseClient = () => {
    const supabaseUrl = import.meta.env.VITE_SUPABASE_URL
    const supabaseKey = import.meta.env.VITE_SUPABASE_ANON_KEY

    if (!supabaseUrl || !supabaseKey) {
        console.warn('⚠️ Supabase não configurado. Cache e histórico desabilitados.')
        return null
    }

    return createClient(supabaseUrl, supabaseKey)
}

// --- CONTROLE DE COTA (LOCAL STORAGE) ---
function getCotaUsage(): { date: string; count: number } {
    if (typeof window === 'undefined') return { date: '', count: 0 }

    try {
        const stored = localStorage.getItem(STORAGE_KEY_COTA)
        if (stored) {
            return JSON.parse(stored)
        }
    } catch (e) {
        console.error('Erro ao ler cota local:', e)
    }
    return { date: '', count: 0 }
}

function incrementarCota(): number {
    if (typeof window === 'undefined') return 0

    const hoje = new Date().toISOString().split('T')[0]
    let { date, count } = getCotaUsage()

    if (date !== hoje) {
        date = hoje
        count = 0
    }

    count++
    localStorage.setItem(STORAGE_KEY_COTA, JSON.stringify({ date, count }))
    return count
}

function checkCotaExceeded(): boolean {
    const hoje = new Date().toISOString().split('T')[0]
    const { date, count } = getCotaUsage()
    return date === hoje && count >= COTA_DIARIA_MAXIMA
}

function removeAccents(str: string): string {
    return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "")
}

// --- CÉREBRO NOVO: DIVISOR DE TÓPICOS (v12 + Smart Fallback) ---
async function gerarTermosBuscaIA(materia: string, topicoSujo: string, apiKey: string): Promise<string[]> {

    // Helper interno para tentar invocar a IA com fallback de modelos
    async function runGeminiWithFallback(prompt: string): Promise<string> {
        // 1. Instancia a SDK APENAS UMA VEZ (Mais eficiente)
        const genai = new GoogleGenerativeAI(apiKey)

        // Lista "Sniper" de Modelos (Versões Específicas para evitar 404 de Alias)
        // Inclui -001, -8b e -exp para maximizar compatibilidade
        const modelsToTry = [
            'gemini-1.5-flash-8b',       // Ultra rápido/barato
            'gemini-1.5-flash-001',      // Versão Estável (v1.5)
            'gemini-1.5-flash-002',      // Versão Estável Nova (v1.5)
            'gemini-2.0-flash-exp',      // Experimental (v2.0)
            'gemini-1.5-pro-002',        // Pro (v1.5)
            'gemini-pro'                 // Legacy (v1.0)
        ]

        let lastError = null

        for (const modelName of modelsToTry) {
            try {
                console.log(`🤖 Tentando modelo IA: ${modelName}...`)

                const model = genai.getGenerativeModel({
                    model: modelName,
                    // Garante temperatura baixa para respostas JSON precisas
                    generationConfig: {
                        responseMimeType: "application/json",
                        temperature: 0.1
                    }
                })

                const result = await model.generateContent(prompt)
                const response = await result.response
                return response.text()

            } catch (error) {
                console.warn(`⚠️ Falha no modelo ${modelName}. Tentando o próximo...`)
                lastError = error
                // O loop continua automaticamente para o próximo modelo
            }
        }

        // Se chegou aqui, todos falharam.
        throw lastError
    }

    // --- FALLBACK MANUAL (REGEX) ---
    // Se a IA falhar totalmente (Cota/404), usamos lógica simples para não travar
    function fallbackSplitter(texto: string): string[] {
        console.log("⚠️ Ativando Fallback Manual (Regex)...")
        // 1. Remove termos inúteis
        let limpo = texto.replace(/\b(noções de|compreensão de|básico de|introdução a)\b/gi, "")

        // 2. Quebra por delimitadores comuns: , ; e +
        // Regex: vírgula, ponto e vírgula, ou " e " isolado
        let partes = limpo.split(/,|;| e | \+ /i)

        // 3. Limpa e normaliza
        return partes
            .map(p => p.trim())
            .filter(p => p.length > 2) // Remove sujeira pequena
            .map(p => {
                // Tenta pluralizar basicão (teste simples)
                if (!p.endsWith('s') && !p.endsWith('ão') && p.length > 4) return p
                return p
            })
    }

    try {
        const prompt = `
        Atue como um Especialista Sênior em SEO (Search Engine Optimization) para sites de concursos (QConcursos, TecConcursos).
        Sua tarefa é ler um tópico "sujo" de edital e transformá-lo em uma lista de TAGS DE BUSCA OTIMIZADAS.

        Matéria: "${materia}"
        Tópico Original: "${topicoSujo}"

        REGRAS CRÍTICAS DE PROCESSAMENTO:
        1. **DETECÇÃO DE MÚLTIPLOS ASSUNTOS:** Identifique e SEPARE conectivos "e", "ou", "&" (Ex: "SO e Redes" -> ["SO", "Redes"]).
        2. **NORMALIZAÇÃO:** Converta para o padrão da indústria (Singular->Plural, "Atos" -> "Atos Administrativos").
        3. **LIMPEZA:** Remova "noções de", "básico de".
        4. **SAÍDA:** Retorne APENAS um Array JSON de strings.

        EXEMPLOS:
        - "sistema operacional e redes" -> ["Sistemas Operacionais", "Redes de Computadores"]

        SAÍDA OBRIGATÓRIA:
        Apenas o Array JSON de strings (string[]). Sem markdown.
        `

        // Executa com a lógica de fallback
        let text = await runGeminiWithFallback(prompt)

        console.log("--- DEBUG RAW IA RESPONSE ---")
        console.log(text)
        console.log("-----------------------------")

        // Limpeza de segurança (caso a IA mande markdown)
        text = text.replace(/```json/g, '').replace(/```/g, '').trim()

        try {
            const termosArray = JSON.parse(text)
            if (!Array.isArray(termosArray)) {
                return [termosArray.toString()]
            }
            return termosArray.map((item: any) => String(item).trim())

        } catch (jsonError) {
            console.error("ERRO JSON PARSE:", jsonError)
            console.log("Falhou texto:", text)
            // Se JSON falhar, infelizmente falha a requisição (Para o usuário ver o erro)
            throw new Error("IA retornou formato inválido (não JSON).")
        }

    } catch (e) {
        console.error("Erro Fatal na IA (Todos os modelos falharam):", e)
        // REPASSA O ERRO para a UI mostrar o Toast de falha e o usuário saber que precisa por crédito
        throw e
    }
}

// --- BUSCA (GOOGLE CUSTOM SEARCH API) ---
async function buscarGoogle(
    query: string,
    apiKey: string,
    cx: string,
    anosPreferencia: number = 3
): Promise<{ volume: number, usadas: number }> {

    let usadasReq = 0
    const url = "https://www.googleapis.com/customsearch/v1"

    if (checkCotaExceeded()) {
        return { volume: 0, usadas: 0 }
    }

    // Tentativa 1: Recente (com dateRestrict)
    const params1 = new URLSearchParams({
        key: apiKey,
        cx: cx,
        q: query,
        dateRestrict: `y${anosPreferencia}`
    })

    try {
        let resp = await fetch(`${url}?${params1.toString()}`)
        usadasReq += incrementarCota()
        let data = await resp.json()
        let total = parseInt(data.searchInformation?.totalResults || '0', 10)

        // Se achou algo recente, ótimo!
        if (total > 0) return { volume: total, usadas: usadasReq }

        // Tentativa 2: Histórico (Fallback - sem dateRestrict)
        // Verifica cota de novo antes de gastar mais 1 request
        if (checkCotaExceeded()) return { volume: 0, usadas: usadasReq }

        const params2 = new URLSearchParams({
            key: apiKey,
            cx: cx,
            q: query
        })

        resp = await fetch(`${url}?${params2.toString()}`)
        usadasReq += incrementarCota()
        data = await resp.json()
        total = parseInt(data.searchInformation?.totalResults || '0', 10)

        return { volume: total, usadas: usadasReq }

    } catch (error) {
        console.error("Erro Técnico na Busca:", error)
        try {
            // Última tentativa: Se falhar fetch, retorna 0 mas não crasha
            return { volume: 0, usadas: usadasReq }
        } catch (e) {
            return { volume: 0, usadas: 0 }
        }
    }
}

// --- FUNÇÃO PRINCIPAL (ORQUESTRADOR) ---
export async function calcularNotaTendencia(
    materia: string,
    topicoSujo: string,
    inputBanca: string,
    inputCarreira: string,
    apiKey: string,
    cx: string,
    anos: number = 3
): Promise<TrendResult> {

    // 1. IA define sub-tópicos (ARRAY)
    // Se falhar, retorna [topicoSujo]
    const subTopicosIA = await gerarTermosBuscaIA(materia, topicoSujo, apiKey)

    // 2. Definição das Bancas
    let listaBancas: string[] = ["Geral"]
    if (inputBanca && inputBanca.trim()) {
        listaBancas = inputBanca.split(',').map(b => b.trim().toUpperCase()).filter(b => b)
    }

    const sufixoCarreira = (inputCarreira && inputCarreira.trim()) ? ` ${inputCarreira.trim()}` : ""

    // Variáveis para guardar o "Campeão" (Maior Volume = Maior Risco GUT)
    let maiorVolumeGeral = 0
    let termoCampeao = ""
    let logDetalhado: string[] = []
    let usadasSessao = 0

    // 3. Loop Duplo: Para cada Banca -> Para cada Sub-tópico
    // Limite de bancas para não estourar a cota (máx 3 bancas)
    for (const banca of listaBancas.slice(0, 3)) {
        for (const subTermo of subTopicosIA) {

            // Monta Query: Materia + SubTermo + Banca (se não for geral)
            // Removendo acentos da matéria para padronizar busca textual
            const materiaLimpa = removeAccents(materia.trim())
            let query = `${materiaLimpa} "${subTermo}"`

            if (banca !== "Geral") {
                query += ` ${banca}`
            }
            query += sufixoCarreira

            const res = await buscarGoogle(query, apiKey, cx, anos)
            usadasSessao += res.usadas

            logDetalhado.push(`[${banca}] ${subTermo}: ${res.volume}`)

            // Lógica GUT: Ficamos com o MAIOR volume encontrado
            if (res.volume > maiorVolumeGeral) {
                maiorVolumeGeral = res.volume
                termoCampeao = subTermo
            }
        }
    }

    // Se nenhum volume encontrado, o termo campeão é o primeiro da lista (só para exibição visual)
    if (!termoCampeao && subTopicosIA.length > 0) {
        termoCampeao = subTopicosIA[0]
    }

    // 4. Régua GUT (Calibragem)
    let nota: 1 | 2 | 3 | 4 | 5 = 1
    const limites = [1000, 500, 200, 50] // Régua v12

    if (maiorVolumeGeral > limites[0]) nota = 5
    else if (maiorVolumeGeral > limites[1]) nota = 4
    else if (maiorVolumeGeral > limites[2]) nota = 3
    else if (maiorVolumeGeral > limites[3]) nota = 2
    else nota = 1

    return {
        materia,
        topicoOriginal: topicoSujo,
        sub_topicos_ia: subTopicosIA,
        termo_maior_risco: termoCampeao,
        carreira: inputCarreira || "Todas",
        filtro_tempo: `Auto Detect (Pref. ${anos} anos)`,
        volume_maximo: maiorVolumeGeral,
        nota_gut: nota,
        bancas_analisadas: listaBancas,
        log_detalhado: logDetalhado,
        api_stats: {
            usadas_sessao: usadasSessao,
            restantes: Math.max(0, COTA_DIARIA_MAXIMA - getCotaUsage().count),
            cota_maxima: COTA_DIARIA_MAXIMA
        }
    }
}
// ============================================
// FUNÇÃO DE AUTOMAÇÃO (v16.5)
// ============================================

/**
 * Busca o próximo tópico pendente no banco e processa automaticamente
 * @returns Resultado do processamento ou erro
 */
export async function processNextPendingTopic(
    googleApiKey: string,
    searchEngineId: string,
    userId?: string
): Promise<any> {
    const supabase = getSupabaseClient()
    
    if (!supabase) {
        return { error: 'Supabase não configurado' }
    }

    try {
        // 1️⃣ BUSCAR TÓPICO PENDENTE
        const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString()
        
        const { data: topics, error: queryError } = await supabase
            .from('topics')
            .select('id, nome, materia_id, last_trend_check_at')
            .select('id, nome, materia_id, last_trend_check_at')
            .select('id, nome, materia_id, last_trend_check_at')
            .select('id, nome, materia_id, last_trend_check_at')
            .select('id, nome, materia_id, last_trend_check_at')
            .select('id, nome, materia_id, last_trend_check_at')
            .select('id, nome, materia_id, last_trend_check_at')
            .or(`last_trend_check_at.is.null,last_trend_check_at.lt.${thirtyDaysAgo}`)
            .order('last_trend_check_at', { ascending: true, nullsFirst: true })
            .limit(1)
            .single()

        if (queryError) {
            console.error('Erro ao buscar tópico pendente:', queryError)
            return { error: `Erro no banco: ${queryError.message}` }
        }

        if (!topics) {
            return { error: 'Nenhum tópico pendente encontrado' }
        }

        
        // 2️⃣ BUSCAR MATÉRIA (Query separada - máxima compatibilidade)
        let materiaName = 'Geral'
        if (topic.materia_id) {
            try {
                const { data: materia } = await supabase
                    .from('materias')
                    .select('nome')
                    .eq('id', topic.materia_id)
                    .single()
                
                if (materia) {
                    materiaName = materia.nome
                }
            } catch (err) {
                console.warn('⚠️ Matéria não encontrada, usando fallback')
            }
        }
        const topic = topics
        // Matéria buscada acima

        console.log(`📝 Tópico selecionado: "${topic.nome}" (${materiaName})`)

        // 2️⃣ PROCESSAR COM A CALCULADORA GUT
        const result = await calcularNotaTendencia(
            materiaName,
            topic.nome,
            '', // banca
            '', // carreira
            googleApiKey,
            searchEngineId,
            3 // anos
        )

        // 3️⃣ ATUALIZAR TIMESTAMP DO TÓPICO
        const { error: updateError } = await supabase
            .from('topics')
            .update({ last_trend_check_at: new Date().toISOString() })
            .eq('id', topic.id)

        if (updateError) {
            console.warn('⚠️ Não foi possível atualizar timestamp:', updateError)
        } else {
            console.log(`✅ Tópico "${topic.nome}" marcado como processado`)
        }

        // 4️⃣ RETORNAR RESULTADO COMPLETO
        return {
            ...result,
            topico_id: topic.id,
            topico_nome: topic.nome,
            materia: materiaName
        }

    } catch (error) {
        console.error('❌ Erro ao processar tópico pendente:', error)
        return { error: `Erro inesperado: ${error}` }
    }
}
